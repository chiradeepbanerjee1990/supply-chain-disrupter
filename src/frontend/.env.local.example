# Not needed for local dev — Vite proxies /api to http://127.0.0.1:8173
# (see vite.config.ts). Only set this if the backend runs somewhere else.
# VITE_API_BASE_URL=http://localhost:8173

# Password for the login gate (src/app/LoginGate.tsx). Required — if
# unset, the login screen never succeeds (fail-safe by design).
# VITE_LOGIN_PASSWORD=changeme
