# Frontend dev tooling — the API image never serves the React app directly.
src/frontend/node_modules
src/frontend/dist

# Python cruft
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Generated/local-only — outputs/ is rebuilt by RUN python scripts/build_databases.py
outputs
data/processed
data/*.db
data/trulens

# VCS / IDE / env
.git
.gitignore
.venv
.claude
*.local

# Not needed inside the API image
fine_tuning
tests
docs
Handoff

# evaluation/ is NOT fully excluded: evaluation/ragas/*.json are committed,
# static RAGAS score files that src/rag/utils.py reads at runtime for
# /api/rag/scorecard + /api/rag/gold-dataset (RAGAS_SCORES_PATH /
# RAGAS_GOLD_DATASET_PATH). Only exclude the offline evaluation scripts and
# their cache, which the API never runs.
evaluation/*.py
evaluation/qa_*.py
evaluation/ragas/__pycache__
evaluation/ragas/*.py
